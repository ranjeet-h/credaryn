# Optional browser origins allowed to call the verifier API.
CREDARYN_VERIFIER_PORT=8080
CREDARYN_ALLOWED_ORIGINS=http://localhost:8080

# Use an operator-managed secret file for PostgreSQL when the status profile is enabled.
# Create deploy/secrets/postgres_password locally; it is intentionally gitignored.
# Create deploy/secrets/dss_keystore_password for the default DSS service.

# Optional status profile: enables transitions when set (bearer token for the status API).
STATUS_ADMIN_TOKEN=

# Optional verifier -> status service wiring. Leave CREDARYN_STATUS_URL empty to keep
# lifecycle UNCHECKED. The Compose-internal hop is plain HTTP, so opt in explicitly; use
# an HTTPS URL instead for anything outside the Compose network.
CREDARYN_STATUS_URL=
CREDARYN_STATUS_ALLOW_INSECURE=false

# Optional OTLP exporter for the verifier. Empty keeps telemetry local.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Air-gapped override: path to an operator-provided local public trust bundle.
CREDARYN_AIR_GAPPED_TRUST_BUNDLE=./trust/air-gapped-trust-store.json
