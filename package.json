{
  "name": "credaryn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Trust infrastructure for verifiable documents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "credaryn": "tsx cli/credaryn/src/main.ts",
    "lint": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "pnpm test",
    "test:property": "vitest run packages/core/test/property.test.ts",
    "test:fuzz": "tsx scripts/fuzz.ts",
    "test:mutation": "tsx scripts/mutation.ts",
    "coverage": "vitest run --coverage",
    "format:check": "git diff --check",
    "bundle:inspect": "node scripts/check-browser-bundle.mjs",
    "demo:build": "pnpm --filter @credaryn/example-invoice-puppeteer generate",
    "demo:start": "pnpm --filter @credaryn/playground start",
    "docs:check": "vitest run apps/playground/test/documentation.test.ts --run",
    "provider:smoke": "tsx scripts/provider-smoke.ts",
    "key-rotation:demo": "tsx scripts/key-rotation-demo.ts",
    "deploy:smoke": "tsx scripts/deploy-smoke.ts",
    "pades:validate": "tsx scripts/pades-validate.ts",
    "pades:validate:all": "tsx scripts/pades-validate.ts --validator dss && tsx scripts/pades-validate.ts --validator independent",
    "changeset": "changeset",
    "version": "changeset version",
    "vectors:reproduce": "pnpm --filter @credaryn/paper vectors:check",
    "compatibility:report": "tsx scripts/compatibility-report.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "sbom:check": "tsx scripts/sbom.ts",
    "release:dry-run": "tsx scripts/release-dry-run.ts",
    "interop:vectors:check": "vitest run standards/trustvc/test/interoperability.test.ts",
    "adapter:fixtures:check": "vitest run packages/pdf/test/adapters.test.ts",
    "project:audit": "tsx scripts/project-audit.ts --check",
    "final:user-journeys": "tsx scripts/final-user-journeys.ts --check",
    "final:self-host-check": "tsx scripts/final-self-host-check.ts --check",
    "final:air-gap-check": "tsx scripts/final-air-gap-check.ts --check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "5.0.1",
    "@types/node": "24.13.5",
    "cbor-x": "1.6.6",
    "fast-check": "4.10.1",
    "tsx": "4.20.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
